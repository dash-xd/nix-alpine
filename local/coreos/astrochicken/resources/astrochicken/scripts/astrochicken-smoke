#!/usr/bin/bash
set -Eeuo pipefail

app_user="$(</run/astrochicken/app-user)"
[[ "$app_user" =~ ^astrochicken-[a-f0-9]{12}$ ]] || { echo "Invalid generated Astrochicken account" >&2; exit 1; }
[[ "$(/usr/bin/id -un)" == "$app_user" ]] || { echo "Astrochicken smoke ran under the wrong account" >&2; exit 1; }
[[ "$(podman info --format '{{.Host.Security.Rootless}}')" == true ]] || { echo "Podman is not rootless" >&2; exit 1; }
podman exec nix-alpine-astrochicken nix --version
podman exec nix-alpine-astrochicken nix eval --raw /workspaces/astrochicken-flake#answer | grep -qx 42
podman exec nix-alpine-astrochicken test -r /workspaces/nix-alpine/local/Makefile
podman exec nix-alpine-astrochicken sh -c 'printf "%s\n" "$USER" > /workspaces/.astrochicken-workspace-write.pass'
podman exec nix-alpine-astrochicken sh -c 'printf "persistent-nix-store\n" > /nix/.astrochicken-store-write.pass'
test -s "$HOME/workspaces/.astrochicken-workspace-write.pass"
echo "PASS: rootless Astrochicken systemd service mounted/evaluated a flake and can write its workspace and Nix store"
