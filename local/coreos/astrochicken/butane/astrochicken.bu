variant: fcos
version: 1.7.0
systemd:
  units:
    - name: astrochicken-identities.service
      enabled: true
    - name: astrochicken-bootstrap.service
      enabled: true
storage:
  files:
    - path: /etc/systemd/system/astrochicken-identities.service
      mode: 0644
      contents:
        local: astrochicken/systemd/astrochicken-identities.service
    - path: /usr/local/libexec/astrochicken-identities
      mode: 0755
      contents:
        local: astrochicken/scripts/astrochicken-identities
    - path: /etc/systemd/system/astrochicken-bootstrap.service
      mode: 0644
      contents:
        local: astrochicken/systemd/astrochicken-bootstrap.service
    - path: /usr/local/libexec/astrochicken-bootstrap
      mode: 0755
      contents:
        local: astrochicken/scripts/astrochicken-bootstrap
    - path: /usr/local/libexec/astrochicken-smoke
      mode: 0755
      contents:
        local: astrochicken/scripts/astrochicken-smoke
    - path: /etc/astrochicken/nix-alpine-source.tar.gz
      mode: 0644
      contents:
        local: astrochicken/nix-alpine-source.tar.gz
    - path: /etc/astrochicken/flake-fixture/flake.nix
      mode: 0644
      contents:
        local: astrochicken/flake-fixture/flake.nix
    - path: /etc/astrochicken/app-skel/.config/systemd/user/nix-alpine-image.service
      mode: 0644
      contents:
        local: astrochicken/systemd/nix-alpine-image.service
    - path: /etc/astrochicken/app-skel/.config/systemd/user/astrochicken-smoke.service
      mode: 0644
      contents:
        local: astrochicken/systemd/astrochicken-smoke.service
    - path: /etc/astrochicken/app-skel/.config/containers/systemd/nix-alpine-astrochicken.container
      mode: 0644
      contents:
        local: astrochicken/quadlet/nix-alpine-astrochicken.container
    - path: /etc/astrochicken/app-skel/.config/containers/systemd/nix-alpine-astrochicken-store.volume
      mode: 0644
      contents:
        local: astrochicken/quadlet/nix-alpine-astrochicken-store.volume
  links:
    - path: /etc/astrochicken/app-skel/.config/systemd/user/default.target.wants/astrochicken-smoke.service
      target: ../astrochicken-smoke.service
      hard: false
