variant: fcos
version: 1.7.0
systemd:
  units:
    - name: getty@tty1.service
      dropins:
        - name: 10-astrochicken-console-autologin.conf
          contents: |
            [Unit]
            Requires=astrochicken-identities.service
            After=astrochicken-identities.service
            [Service]
            EnvironmentFile=/run/astrochicken-console/getty.env
            ExecStart=
            ExecStart=-/usr/sbin/agetty --autologin ${ASTROCHICKEN_CONSOLE_USER} --noclear %I $TERM
storage:
  files:
    - path: /etc/profile.d/astrochicken-readonly-login.sh
      mode: 0644
      contents:
        local: astrochicken/scripts/astrochicken-readonly-login
    - path: /etc/astrochicken/console-enabled
      mode: 0444
      contents:
        inline: enabled
