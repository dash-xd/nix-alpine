[Unit]
Description=Nix-Alpine build workspace (@SCOPE@)
RequiresMountsFor=@WORKSPACES@

[Container]
ContainerName=@CONTAINER@
Image=@IMAGE@
Pull=never
Volume=@VOLUME@:/nix
Volume=@WORKSPACES@:/workspaces:rw
WorkingDir=/workspaces
Environment=HOME=/home/nixuser
Exec=sleep infinity
UserNS=keep-id
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
