[Unit]
Description=Nix-Alpine toolbox @VERSION@ (@WORKSPACE_KEY@/@SCOPE@)
RequiresMountsFor=@WORKSPACES@ @STATE_ROOT@

[Container]
ContainerName=@CONTAINER@
Image=@IMAGE@
Pull=never
Label=org.opencontainers.image.version=@VERSION@
Label=org.opencontainers.image.revision=@SOURCE_REV@
Label=io.nix-alpine.workspace=@WORKSPACE_KEY@
Label=io.nix-alpine.scope=@SCOPE@
Volume=@VOLUME@:/nix
Volume=@WORKSPACES@:/workspaces:rw
Volume=@STATE_ROOT@:/run/nix-alpine/coreos-qemu:rw
Volume=@RELEASE_STATE@:/run/nix-alpine/releases:ro
WorkingDir=/workspaces
Environment=HOME=/home/nixuser
Exec=sleep infinity
UserNS=keep-id
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
