[Unit]
Description=nix.xd toolbox @VERSION@ (@WORKSPACE_KEY@/@SCOPE@)
RequiresMountsFor=@WORKSPACES@ @STATE_ROOT@

[Container]
ContainerName=@CONTAINER@
Image=@IMAGE@
Pull=never
Label=org.opencontainers.image.version=@VERSION@
Label=org.opencontainers.image.revision=@SOURCE_REV@
Label=io.nix-alpine.workspace=@WORKSPACE_KEY@
Label=io.nix-alpine.scope=@SCOPE@
Volume=@VOLUME@:/nix:nocopy
Volume=@WORKSPACES@:/workspaces:@WORKSPACE_ACCESS@
@SOPS_AGE_VOLUME@
Volume=@STATE_ROOT@:/run/nix-alpine/coreos-qemu:rw
Volume=@RELEASE_STATE@:/run/nix-alpine/releases:ro
WorkingDir=/workspaces
Environment=HOME=/home/nixuser
Environment=GOMODCACHE=@GO_MOD_CACHE@
Environment=GOCACHE=@GO_BUILD_CACHE@
Environment=XDG_CACHE_HOME=@XDG_CACHE_DIR@
@SOPS_AGE_ENV@
Exec=sleep infinity
UserNS=keep-id:uid=1000,gid=1000
NoNewPrivileges=true

[Service]
TimeoutStartSec=120s
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
